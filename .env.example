# ─────────────────────────────────────────────────────────────
# Trade Bot — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# All values below are optional — defaults are shown.
# ─────────────────────────────────────────────────────────────

# ── Secrets (required for live features) ─────────────────────
OPENROUTER_API_KEY=sk-or-your-key-here   # required for AI advisory

# ── Exchange ──────────────────────────────────────────────────
EXCHANGE=kraken          # kraken | binance | kucoin | okx | coinbase | bybit
SYMBOL=BTC/USDT          # any ccxt unified symbol e.g. ETH/USDT SOL/USDT
FEED_MODE=live           # live | simulated
LOOP_INTERVAL=30         # seconds between ticks
LIMIT_ORDER_ENABLED=false        # true = post-only limit orders (maker fee 0.16%), false = market orders
LIMIT_CHASE_TIMEOUT_S=120        # seconds to wait per attempt before repricing
LIMIT_CHASE_MAX_RETRIES=3        # max reprice attempts before falling back to market order
LIMIT_CHASE_TICK_PCT=0.0001      # price offset inside spread as % of price (0.0001 = 0.01%)

# ── Strategy ─────────────────────────────────────────────────
STRATEGY_MODE=indicator  # indicator | threshold

# Indicator strategy (used when STRATEGY_MODE=indicator)
RSI_PERIOD=14
RSI_OVERSOLD=30.0        # buy signal when RSI below this
RSI_OVERBOUGHT=70.0      # sell signal when RSI above this
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
ADX_PERIOD=14            # period for ADX calculation (Wilder's smoothing)
ADX_THRESHOLD=25.0       # signals filtered out when ADX < this (ranging market)
MAX_EMA_SPREAD_PCT=0.0   # 0 = disabled; 0.005 = only enter when EMAs < 0.5% apart
RSI_FILTER_ENABLED=true  # false = bypass RSI level/direction checks entirely
ATR_SL_MULT=0.0          # 0 = disabled (uses fixed STOP_LOSS_PCT); >0 = ATR-based live stop (e.g. 2.0 = 2×ATR below entry)
ATR_TP_MULT=4.0          # TP = entry_price + ATR × this multiplier; R/R = tp_mult / sl_mult
ATR_PERIOD=14            # candles for ATR calculation (Wilder's smoothing)

# Threshold strategy (used when STRATEGY_MODE=threshold)
BUY_THRESHOLD=67000.0
SELL_THRESHOLD=70000.0

# ── Risk (most important — read carefully) ────────────────────
RISK_PER_TRADE_PCT=0.005     # 0.5% of cash per trade — controls position size dynamically
                              # e.g. $10,000 × 0.5% = $50 per trade
RISK_MAX_POSITION_PCT=0.03   # 3% — max portfolio exposure in one position at any time
RISK_DAILY_LOSS_LIMIT=0.01   # 1% — block new BUYs if portfolio drops this much today
                              # SELL always allowed — you can always exit an open position
RISK_MAX_DRAWDOWN=0.05       # 5% — block new BUYs if portfolio drops 5% from all-time peak
                              # SELL always allowed — you can always exit an open position
RISK_MAX_TRADES_PER_DAY=3    # hard cap on fills per calendar day
COOLDOWN_TICKS=10            # candles to wait after each trade before next allowed

# ── Portfolio ─────────────────────────────────────────────────
STARTING_CASH=10000.0        # simulated starting balance (paper trading only)
SIM_START_PRICE=68500.0      # simulated feed start price
SIM_VOLATILITY=200.0         # simulated feed price movement per tick

# ── AI Advisory ───────────────────────────────────────────────
AI_ENABLED=true
AI_MODEL=deepseek/deepseek-v4-flash:free
AI_MIN_CONFIDENCE=0.65       # ignore AI signals below this confidence
AI_TIMEOUT_S=8.0

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH=30         # seconds between browser auto-refresh

# ── External Signals ──────────────────────────────────────────
EXT_FNG_ENABLED=true         # Fear & Greed gate — block BUY when extreme greed
EXT_FUNDING_ENABLED=false    # Funding rate gate — disabled: Kraken is spot only, no perp funding data
                              # Set true only if trading a perp exchange (Binance, Bybit, OKX)
                              # and set EXT_FUNDING_SYMBOL to match your base asset (e.g. ETHUSD)

# ── Backtest ──────────────────────────────────────────────────
BACKTEST_TIMEFRAME=1h        # 1m 5m 15m 30m 1h 2h 4h 6h 12h 1d 1w
BACKTEST_LIMIT=500           # number of historical candles to fetch
BACKTEST_FEE_PCT=0.001       # 0.1% per trade (typical exchange taker fee)
STOP_LOSS_PCT=0.02           # exit if price drops 2% from entry (0 = disabled)
TAKE_PROFIT_PCT=0.04         # exit if price rises 4% from entry (0 = disabled)

# ── Universe (dynamic symbol selection) ───────────────────────
PAPER_MODE=false             # true = paper trading mode (no real orders placed)
PAPER_STARTING_CASH=1000.00  # simulated cash balance for paper trading

UNIVERSE_ENABLED=false       # true = scan all CAD pairs and pick top movers each run
UNIVERSE_SIZE=5              # number of top symbols to trade
UNIVERSE_MIN_VOL_CAD=1000    # minimum 24h quote volume (CAD) to be eligible
UNIVERSE_QUOTE=CAD           # quote currency to scan
UNIVERSE_EXCLUDE=EUR,USD,USDC,USDT,DAI,BUSD  # base symbols to exclude (comma-separated)
