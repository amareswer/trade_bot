# ─────────────────────────────────────────────────────────────
# Trade Bot — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# EXCHANGE and SYMBOL are REQUIRED — the bot refuses to start without them.
# Everything else is optional; values shown are recommended starting points.
# ─────────────────────────────────────────────────────────────

# ── Secrets (required for live features) ─────────────────────
OPENROUTER_API_KEY=sk-or-your-key-here   # required for AI advisory
# EXCHANGE_API_KEY=your-key-here         # required when LIVE_TRADING=true — works for any ccxt exchange
# EXCHANGE_API_SECRET=your-secret-here   # (legacy KRAKEN_API_KEY / KRAKEN_API_SECRET still accepted)
# TELEGRAM_BOT_TOKEN=your-bot-token      # required for alerts + two-way control below (optional feature)
# TELEGRAM_CHAT_ID=your-chat-id          # shared with the stock bot — see TELEGRAM_CONTROL_ENABLED note

# ── Exchange ──────────────────────────────────────────────────
EXCHANGE=kraken          # kraken | binance | kucoin | okx | coinbase | bybit
SYMBOL=BTC/USDT          # any ccxt unified symbol e.g. ETH/USDT SOL/USDT
FEED_MODE=live           # live | simulated
LOOP_INTERVAL=30         # seconds between ticks
CANDLE_MINUTES=240       # candle timeframe in minutes (240 = 4h) — 4h is the only validated live timeframe; 1h failed walk-forward
LIVE_TRADING=false       # true = place real orders (needs EXCHANGE_API_KEY/SECRET) — false = simulated/paper feed only
DRY_RUN=false            # true = go through the live order-placement code path but never actually send anything (validation only)
ORDER_TYPE=market        # market | limit — limit only takes effect when LIMIT_ORDER_ENABLED=true below
LIMIT_ORDER_ENABLED=false        # true = post-only limit orders (maker fee 0.40%, confirmed), false = market orders
LIMIT_CHASE_TIMEOUT_S=120        # seconds to wait per attempt before repricing
LIMIT_CHASE_MAX_RETRIES=3        # max reprice attempts before falling back to market order
LIMIT_CHASE_TICK_PCT=0.0001      # price offset inside spread as % of price (0.0001 = 0.01%)
NATIVE_STOP_LOSS_ENABLED=false   # true = also rest a real stop order on the exchange after every BUY fill (protects a position even while the bot itself is down) — validate live before enabling

# ── Strategy ─────────────────────────────────────────────────
STRATEGY_MODE=indicator  # indicator | threshold

# Indicator strategy (used when STRATEGY_MODE=indicator)
RSI_PERIOD=14
RSI_OVERSOLD=30.0        # buy signal when RSI below this
RSI_OVERBOUGHT=70.0      # sell signal when RSI above this
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
ADX_PERIOD=14            # period for ADX calculation (Wilder's smoothing)
ADX_THRESHOLD=18.0       # signals filtered out when ADX < this (ranging market) — 18 validated 2026-06-19; do not change without re-running walk-forward
ADX_MAX=0.0              # 0 = disabled; >0 = also filter out signals when ADX is ABOVE this (avoid chasing an already-extended move)
MIN_EMA_SPREAD_PCT=0.004 # require fast EMA >= this % above slow EMA to enter — validated 2026-06-27
MAX_EMA_SPREAD_PCT=0.0   # 0 = disabled; 0.005 = only enter when EMAs < 0.5% apart
RSI_FILTER_ENABLED=true  # false = bypass RSI level/direction checks entirely
VOLUME_K=0.0              # 0 = disabled; >0 = require volume >= K × its rolling average to enter
REGIME_EMA_PERIOD=200            # macro trend filter EMA period — BUYs only allowed above this EMA
REGIME_EMA_SLOPE_FILTER=false    # true = also require the macro EMA itself to be sloping upward, not just price above it
ATR_SL_MULT=0.0          # 0 = disabled (uses fixed STOP_LOSS_PCT); >0 = ATR-based live stop (e.g. 2.0 = 2×ATR below entry) — 2.0 validated 2026-07-17
ATR_TP_MULT=4.0          # TP = entry_price + ATR × this multiplier; R/R = tp_mult / sl_mult
ATR_PERIOD=14            # candles for ATR calculation (Wilder's smoothing)
ATR_SIZING_ENABLED=false # true = cap BUY quantity so an ATR-based stop-out never risks more $ than the fixed-SL baseline would (only matters when ATR_SL_MULT > 0)
TRAILING_STOP_PCT=0.0            # 0 = disabled; >0 = trail the stop up behind price by this % once armed (dormant whenever ATR_SL_MULT > 0 — the ATR stop takes priority)
TRAILING_STOP_ACTIVATION_PCT=0.03  # unrealized gain % required before the trailing stop arms

# Threshold strategy (used when STRATEGY_MODE=threshold)
BUY_THRESHOLD=67000.0
SELL_THRESHOLD=70000.0

# ── Risk (most important — read carefully) ────────────────────
RISK_PER_TRADE_PCT=0.005     # 0.5% of cash per trade — controls position size dynamically
                              # e.g. $10,000 × 0.5% = $50 per trade
RISK_MAX_POSITION_PCT=0.03   # 3% — max portfolio exposure in one position at any time
RISK_DAILY_LOSS_LIMIT=0.01   # 1% — block new BUYs if portfolio drops this much today
                              # SELL always allowed — you can always exit an open position
RISK_MAX_DRAWDOWN=0.05       # 5% — block new BUYs if portfolio drops 5% from all-time peak
                              # SELL always allowed — you can always exit an open position
RISK_MAX_TRADES_PER_DAY=3    # hard cap on fills per calendar day
COOLDOWN_TICKS=10            # candles to wait after each trade before next allowed

# ── Portfolio ─────────────────────────────────────────────────
STARTING_CASH=10000.0        # simulated starting balance (paper trading only) — for LIVE_TRADING=true, the real exchange balance is used instead
SIM_START_PRICE=68500.0      # simulated feed start price
SIM_VOLATILITY=200.0         # simulated feed price movement per tick
MAX_SLOT_CASH_CAD=0.0        # 0 = uncapped; >0 = hard ceiling per symbol slot regardless of STARTING_CASH/MAX_CONCURRENT_POSITIONS math (prevents a symbol removal from silently growing survivors' allocation)
# MAX_SLOT_CASH_CAD_<BASE>=  # optional per-symbol override, e.g. MAX_SLOT_CASH_CAD_BTC=77 — added 2026-08-24, falls back to the shared MAX_SLOT_CASH_CAD above for any symbol without its own override

# ── Alerts ────────────────────────────────────────────────────
TELEGRAM_ENABLED=false           # true = send fill/risk/crash alerts to Telegram (needs TELEGRAM_BOT_TOKEN/CHAT_ID above)
TELEGRAM_CONTROL_ENABLED=false   # true = also start an inbound getUpdates poller (/status, /pause, /resume, ...) — see CLAUDE.md before enabling on more than one bot process against the same token, Telegram's getUpdates offset is single-consumer-per-token
HEARTBEAT_URL=                   # optional healthchecks.io (or similar) ping URL — empty disables

# ── AI Advisory ───────────────────────────────────────────────
AI_ENABLED=true
AI_MODEL=deepseek/deepseek-v4-flash:free
AI_MIN_CONFIDENCE=0.65       # ignore AI signals below this confidence
AI_TIMEOUT_S=8.0

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH=30         # seconds between browser auto-refresh

# ── External Signals ──────────────────────────────────────────
EXT_FNG_ENABLED=true         # Fear & Greed gate — block BUY when extreme greed
EXT_FUNDING_ENABLED=false    # Funding rate gate — disabled: Kraken is spot only, no perp funding data
                              # Set true only if trading a perp exchange (Binance, Bybit, OKX)
                              # and set EXT_FUNDING_SYMBOL to match your base asset (e.g. ETHUSD)

# ── Backtest ──────────────────────────────────────────────────
BACKTEST_TIMEFRAME=4h        # 1m 5m 15m 30m 1h 2h 4h 6h 12h 1d 1w — 4h validated; 1h rejected (PF 0.49)
BACKTEST_LIMIT=5000          # number of historical candles to fetch
BACKTEST_FEE_PCT=0.008       # 0.8% per trade (Kraken taker rate — corrected 2026-07-01; was wrong 0.001)
STOP_LOSS_PCT=0.015          # exit if price drops 1.5% from entry (0 = disabled) — validated 2026-06-19
TAKE_PROFIT_PCT=0.10         # exit if price rises 10% from entry (0 = disabled) — validated 2026-06-19

# ── Universe (dynamic symbol selection) ───────────────────────
PAPER_MODE=false             # true = paper trading mode (no real orders placed)
PAPER_STARTING_CASH=1000.00  # simulated cash balance for paper trading

UNIVERSE_ENABLED=false       # true = scan all CAD pairs and pick top movers each run
MAX_CONCURRENT_POSITIONS=2   # must match UNIVERSE_SIZE when UNIVERSE_WHITELIST is set
UNIVERSE_SIZE=2              # number of symbols to trade (matches whitelist below)
UNIVERSE_MIN_VOL_CAD=1000    # minimum 24h quote volume (CAD) to be eligible
UNIVERSE_QUOTE=CAD           # quote currency to scan
UNIVERSE_EXCLUDE=EUR,USD,USDC,USDT,DAI,BUSD  # base symbols to exclude (comma-separated)
UNIVERSE_WHITELIST=BTC/CAD,XRP/CAD  # fixed list — skips dynamic scan when set
                                     # BLOCKED (walk-forward failed): ETH/CAD, SOL/CAD, DOGE/CAD
DOGE_VOL_MIN_CAD=50000.0     # regime_monitor.py only: 24h CAD volume DOGE/CAD must clear before its watchlist metrics unlock
REGIME_MONITOR_INTERVAL=14400  # seconds between regime-monitor background checks (14400 = 4h, matches CANDLE_MINUTES)

# NOTE: the values above are safe starting defaults, not this project's live-tuned config.
# CLAUDE.md's "Current Live Configuration" section documents the actual validated live
# values (e.g. RISK_PER_TRADE_PCT=0.10, MAX_SLOT_CASH_CAD=77, NATIVE_STOP_LOSS_ENABLED=true)
# — copy from there, not from here, when standing up a bot meant to match live behavior.
