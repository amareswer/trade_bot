# ── Stock Bot Configuration ───────────────────────────────────
# Copy this file to stock_bot/.env and edit as needed.
# This file is separate from the root .env (crypto bot) — they do not share settings.

# Comma-separated list of symbols to monitor.
# TSX symbols use the .TO suffix; US symbols have none.
WATCHLIST=SHOP.TO,RY.TO,AAPL,NVDA,AC.TO
# MSFT removed — walk-forward FAIL on 2024-now window (PF 0.29). Re-evaluate after strategy update.

# yfinance candle interval.
# Daily ("1d") is recommended for swing/positional analysis.
# Options: 1m 2m 5m 15m 30m 60m 90m 1h 1d 5d 1wk 1mo 3mo
INTERVAL=1d

# Days of history to fetch per symbol (used to warm up indicators).
# RSI(14) + MACD(26+9) needs at least ~50 bars; 200 gives a full year.
LOOKBACK_DAYS=200

# Seconds between full watchlist scans.
LOOP_INTERVAL=60

# ── AI Engine (Phase 3) ───────────────────────────────────────
# Set false to skip AI calls and save API quota during testing.
AI_ENABLED=true

# AI provider to use: openrouter | ollama_local | ollama_cloud | nvidia_nim
AI_PROVIDER=openrouter

# NVIDIA NIM (free tier — 40 rpm)
# Get key at: https://integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenRouter — key lives in root .env (shared with crypto bot), not here.
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Ollama Local — model served at OLLAMA_BASE_URL (no auth required)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud — model served at ollama.com (requires account API key)
# Get a key at https://ollama.com
OLLAMA_CLOUD_API_KEY=

# Model name used by both Ollama providers (ignored for openrouter)
OLLAMA_MODEL=llama3.2

# ── Alerts (Phase 5) ─────────────────────────────────────────
# Terminal alerts are always on. Email and desktop are opt-in.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_PASSWORD=          # Gmail app password — NOT your login password
                               # Generate at: Google Account → Security → App passwords
ALERT_EMAIL_TO=you@gmail.com
ALERT_DESKTOP_ENABLED=false    # requires: pip install plyer

# ── Paper Trading (Phase 6) ───────────────────────────────────
# Enables virtual paper trading driven by AI signals.
# When true, the portfolio section shows dynamic paper P&L
# instead of the static PORTFOLIO string below.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_CASH=10000.0   # virtual cash balance to start with
PAPER_RISK_PCT=0.10            # fraction of cash to allocate per BUY signal (10%)
PAPER_MIN_CONFIDENCE=65        # minimum AI confidence % needed to place a paper trade
PAPER_MAX_POSITIONS=6          # hard cap on concurrent open positions
PAPER_MAX_EXPOSURE_PCT=1.0     # max fraction of equity in open positions (0<x<=1.0). 1.0 =
                               # fully investable, no cash buffer — appropriate for a paper
                               # track-record bot, NOT for a real-money account. The real
                               # risk controls are the per-position stop + the breaker tiers.
PAPER_DAILY_LOSS_PCT=0.03   # halt new paper buys if session P&L drops 3%
PAPER_SLIPPAGE_BPS=15       # simulated fill slippage (15 bps = 0.15%); use 30 for TSX small-caps
PAPER_STOP_LOSS_PCT=0.05       # stop-loss threshold: exit if position falls ≥5% from entry
PAPER_TAKE_PROFIT_PCT=0.12     # take-profit threshold: exit if position rises ≥12% from entry
                               # To swap in Interactive Brokers later: replace
                               # StockPaperExecutor with IBrokerExecutor in main.py.
PAPER_ATR_SIZING_ENABLED=false # opt-in: size shares so an ATR×mult stop never risks more $
                               # than the flat PAPER_STOP_LOSS_PCT baseline, and use that
                               # ATR distance as the actual stop. Default OFF — do NOT enable
                               # without a stock_backtest.py walk-forward PASS on every
                               # RULE_WHITELIST symbol (some fail under an ATR×2.0 stop).
PAPER_ATR_SL_MULT=2.0          # stop distance = ATR(14) × this; only used when the flag is true

# ── Earnings Blackout ─────────────────────────────────────────
# Block BUY signals within N days of next earnings date.
# Earnings gaps can move a stock 10-20% overnight — avoid entering.
# Set to 0 to disable. Recommended: 7 (one week buffer).
# AC.TO earnings: Jul 27 | DLTR earnings: Aug 20
EARNINGS_BLACKOUT_DAYS=7

# ── Macro Economic Event Blackout ─────────────────────────────
# Block ALL new BUYs within MACRO_BLACKOUT_DAYS (before AND after) of a
# listed event date. The monthly jobs report (first Friday) is computed
# automatically. MACRO_EVENT_DATES is the user-maintained list of FOMC /
# CPI / GDP dates — the module does NOT fabricate these. Two-day FOMC
# meetings need both days listed. 0/negative on MACRO_BLACKOUT_DAYS disables.
#   FOMC:  federalreserve.gov/monetarypolicy/fomccalendars.htm
#   CPI:   bls.gov/schedule/news_release/cpi.htm
#   GDP:   bea.gov/news/schedule
# Example below covers the rest of 2026 (CPI Sep11/Oct14/Nov10/Dec10;
# FOMC Sep15-16/Oct27-28/Dec8-9; GDP advance Q3 Oct29). REFRESH each January.
MACRO_BLACKOUT_DAYS=1
MACRO_EVENT_DATES=2026-09-11,2026-09-15,2026-09-16,2026-10-14,2026-10-27,2026-10-28,2026-10-29,2026-11-10,2026-12-08,2026-12-09,2026-12-10

# ── Market Universe Scanner ───────────────────────────────────
# When UNIVERSE_ENABLED=true, the bot scans top movers from configured
# index sources each cycle instead of (or in addition to) the fixed WATCHLIST.
UNIVERSE_ENABLED=false
UNIVERSE_SIZE=15              # top N symbols to pass to AI each cycle
SCREENER_ENABLED=true

# ── Universe Sources ──────────────────────────────────────────
# Comma-separated list of index sources to scan.
# Remove any source to disable it. Order does not matter.
# Valid values: sp500, nasdaq100, sp400, tsx60, tsx_composite, etfs
UNIVERSE_SOURCES=sp500,nasdaq100,sp400,tsx60,tsx_composite,etfs

# ── Universe ETFs ─────────────────────────────────────────────
# Comma-separated list of ETFs to include in universe scan.
# Add or remove any ETF here — no code changes needed.
# Remove 'etfs' from UNIVERSE_SOURCES to disable ETFs entirely.
UNIVERSE_ETFS=XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLB,XLU,XLRE,XLC,SPY,QQQ,IWM,DIA,VTI,ARKK,ARKG,ARKW,SMH,SOXX,EEM,EFA,GLD,SLV,USO,TLT,HYG,XIU.TO,XIC.TO,ZEB.TO,XEG.TO,XFN.TO

# ── Universe Filters ──────────────────────────────────────────
UNIVERSE_BATCH_SIZE=25           # symbols per yf.download() batch (rate-limit guard)
UNIVERSE_BATCH_DELAY=2.0         # seconds to sleep between batches
UNIVERSE_MIN_AVG_VOLUME=300000   # minimum 20-day avg daily volume
UNIVERSE_MIN_PRICE=1.0           # minimum stock price (filters penny stocks)
PRICE_OUTLIER_FACTOR=10          # reject latest close if >10x the median close of the same fetch
UNIVERSE_MIN_SCORE=0.001         # minimum composite momentum score

# ── Universe Scoring Weights (must sum to 1.0) ────────────────
UNIVERSE_WEIGHT_VOL=0.35         # volume surge weight
UNIVERSE_WEIGHT_MOM5D=0.30       # 5-day momentum weight
UNIVERSE_WEIGHT_MOM1D=0.20       # 1-day momentum weight
UNIVERSE_WEIGHT_RELSTR=0.15      # relative strength vs SPY weight

# ── Universe Refresh ──────────────────────────────────────────
# Top-movers re-rank cadence (market hours only): first LIVE cycle of the day,
# then every UNIVERSE_MOVERS_REFRESH_HOURS. Added 2026-08-31 — before that the
# movers list was fixed at open, so a stock breaking out mid-session was
# invisible for BUY until the next morning. <= 0 → once/day only. Held positions
# and the WATCHLIST are always scanned regardless, so sells are never affected.
UNIVERSE_MOVERS_REFRESH_HOURS=2
UNIVERSE_REFRESH_HOURS=4         # raw index-constituent list (S&P500/TSX/ETF membership) cache TTL, hours — separate from the movers re-rank
UNIVERSE_REFRESH_HOUR=16         # (legacy — ignored since 2026-08-27; was the unreachable now_et.hour==16 gate)

# ── Portfolio Tracking (Phase 4.5) ───────────────────────────
# Format: SYMBOL:SHARES:AVG_COST  — comma-separated, no spaces
# Example: SHOP.TO:10:85.20,AAPL:5:195.00,NVDA:3:420.00
# Leave blank to hide the portfolio section entirely.
PORTFOLIO=
BASE_CURRENCY=CAD

# ── Market Regime Filter ─────────────────────────────────────
# Blocks BUY signals when SPY is not in a BULL regime (close > SMA(200) and
# SMA(50) > SMA(200)). Never blocks SELL/exit signals.
REGIME_FILTER_ENABLED=true
REGIME_MA_PERIOD=200     # slow MA period (golden/death cross denominator)
REGIME_FAST_MA=50        # fast MA period (golden/death cross numerator)

# ── Fast Validator (1h candle paper engine) ───────────────────
# Separate paper trading engine running on 1-hour candles for rapid
# signal validation. Uses its own state (fast_validator_state.json)
# and trades log (fast_trades.csv) — never touches paper_trades.csv.
FAST_ENABLED=false           # set true to run fast validator in parallel with the swing bot
FAST_LOOP_INTERVAL=300       # seconds between fast validator cycles (default 5 minutes)
FAST_CANDLE_INTERVAL=1h      # yfinance interval (1m/5m/15m/30m/60m/1h/1d)
FAST_LOOKBACK_HOURS=168      # hours of candle history to fetch (7 days)
FAST_SL_PCT=1.5              # stop-loss % below entry price
FAST_TP_PCT=3.0              # take-profit % above entry price
FAST_MAX_HOLD_HOURS=48       # force-exit if held longer than this (hours)
FAST_MAX_POSITIONS=2         # max simultaneous open positions
FAST_MIN_CONFIDENCE=70       # minimum AI confidence % to enter a trade

# ── Reddit API (Phase 2 — optional) ───────────────────────────
# Create an app at https://www.reddit.com/prefs/apps (script type).
# Leave blank to skip Reddit sentiment gracefully.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockBot/1.0
